{
  "expo": {
    "name": "Loam",
    "slug": "loam",
    "version": "0.0.35",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "experiments": {
      "onDemandFilesystem": false
    },
    "android": {
      "package": "xyz.vpavlin.loam",
      "versionCode": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14100C"
      },
      "backgroundColor": "#14100C"
    },
    "plugins": [
      "./plugins/withSplashColor.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withLogosDelivery.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#82D257"
        }
      ],
      "./plugins/withForegroundService.js",
      "./plugins/withDeliveryService.js",
      "./src/lib/logos-transport-pkg/plugins/withLoamMesh"
    ],
    "extra": {
      "comment": "versionCode here is the source of truth; assert it matches the generated android/app/build.gradle after prebuild."
    },
    "androidStatusBar": {
      "backgroundColor": "#14100C",
      "barStyle": "light-content",
      "translucent": false
    },
    "backgroundColor": "#14100C",
    "scheme": "loam"
  }
}